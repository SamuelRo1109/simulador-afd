' ══════════════════ PATRÓN COMANDO ══════════════════
package "controlador.comandos  «patrón Comando»" as capaComandos {

  interface Comando <<interface>> {
    + ejecutar() : void
    + deshacer() : void
    + descripcion() : String
  }

  class ComandoInstantanea<T> {
    - descripcion : String
    - captor : Supplier<T>
    - restaurador : Consumer<T>
    - mutacion : Runnable
    - antes : T
    - despues : T
    --
    + ejecutar() : void
    + deshacer() : void
    + descripcion() : String
  }

  class ComandoDirecto<T> {
    - descripcion : String
    - antes : T
    - despues : T
    - restaurador : Consumer<T>
    --
    + ejecutar() : void
    + deshacer() : void
    + descripcion() : String
  }

  class PilaComandos {
    + {static} PROFUNDIDAD : int = 50
    - hechos : Deque<Comando>
    - deshechos : Deque<Comando>
    --
    + ejecutar(comando : Comando) : void
